@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
    string Icon(NotificationType t) => t switch
    {
        NotificationType.OrderUpdate => "fa-box",
        NotificationType.CustomOrder => "fa-palette",
        NotificationType.Promotion => "fa-tag",
        _ => "fa-bell"
    };
}

<section class="te-section te-section-light te-profile-page">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3"><partial name="_ProfileSidebar" /></div>
            <div class="col-lg-9">
                <div class="te-profile-header-card d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h1 class="te-profile-header-title">
                            <span class="te-profile-header-card-icon"><i class="far fa-bell"></i></span>
                            Notifications
                        </h1>
                        <p class="te-profile-header-subtitle">Updates on your orders and requests.</p>
                    </div>
                </div>

                @if (Model.Any())
                {
                    <div class="te-form-card p-4 border-0">
                        <div class="te-notif-page-list">
                        @foreach (var n in Model)
                        {
                            <div class="te-notif-page-item @(n.IsRead ? "" : "is-unread")">
                                <div class="te-notif-page-icon te-notif-icon-@n.Type.ToString().ToLower()"><i class="fas @Icon(n.Type)"></i></div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <strong>@n.Title</strong>
                                        <small class="text-muted">@TimeAgo.From(n.CreatedAt)</small>
                                    </div>
                                    <p class="mb-1">@n.Message</p>
                                    @if (!string.IsNullOrEmpty(n.RelatedUrl))
                                    {
                                        <a href="@n.RelatedUrl" class="btn btn-link p-0">View <i class="fas fa-arrow-right"></i></a>
                                    }
                                </div>
                            </div>
                        }
                        </div>
                    </div>
                }
                else
                {
                    <div class="te-form-card text-center py-5 d-flex flex-column justify-content-center align-items-center" style="min-height: 400px;">
                        <div class="te-empty-icon mb-4" style="width: 80px; height: 80px; border-radius: 50%; background: var(--te-light-blush); color: var(--te-dusty-rose); display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto;">
                            <i class="far fa-bell"></i>
                        </div>
                        <h3 style="font-family: var(--font-heading); color: var(--te-text-dark);">No notifications yet</h3>
                        <p class="text-muted mb-4" style="max-width: 400px; margin: 0 auto;">We'll let you know here when there's news about your orders and custom requests.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
