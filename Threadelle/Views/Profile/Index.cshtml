@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<section class="te-section te-section-light te-profile-page">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3"><partial name="_ProfileSidebar" /></div>
            <div class="col-lg-9">
                <div class="te-dashboard-hero mb-4">
                    @if (!string.IsNullOrEmpty(User.ProfileImage()))
                    {
                        <img src="@User.ProfileImage()" class="te-dashboard-hero-avatar" alt="Profile Avatar" />
                    }
                    else
                    {
                        <div class="te-dashboard-hero-avatar-text">@User.FirstName().Substring(0,1).ToUpper()</div>
                    }
                    <div>
                        <h1 class="te-dashboard-hero-title">Hello, <span class="script-font">@User.FirstName()</span> 💕</h1>
                        <p class="te-dashboard-hero-subtitle">@Model.User.Email</p>
                    </div>
                    <span class="te-dashboard-hero-badge"><i class="fas fa-crown"></i> ThreadElle Member</span>
                </div>

                <!-- STATISTICS ROW -->
                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <a asp-controller="Profile" asp-action="Orders" class="te-dashboard-card d-block text-decoration-none">
                            <div class="te-dashboard-card-icon"><i class="fas fa-box-open"></i></div>
                            <div class="te-section-header mb-3">
                                <h3>My Orders <i class="fas fa-sparkles ms-2" style="color: var(--te-dusty-rose); font-size: 0.7em;"></i></h3>
                                <div class="te-section-header-line"></div>
                            </div>
                            <p class="text-muted mb-0">@Model.OrderCount pieces ordered</p>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="Profile" asp-action="CustomOrders" class="te-dashboard-card d-block text-decoration-none">
                            <div class="te-dashboard-card-icon"><i class="fas fa-palette"></i></div>
                            <div class="te-section-header mb-3">
                                <h3>Custom Orders <i class="fas fa-ribbon ms-2" style="color: var(--te-dusty-rose); font-size: 0.7em;"></i></h3>
                                <div class="te-section-header-line"></div>
                            </div>
                            <p class="text-muted mb-0">@Model.CustomOrderCount designs pending</p>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="Profile" asp-action="Edit" class="te-dashboard-card d-block text-decoration-none">
                            <div class="te-dashboard-card-icon"><i class="fas fa-sliders"></i></div>
                            <div class="te-section-header mb-3">
                                <h3>Account Details <i class="fas fa-heart ms-2" style="color: var(--te-dusty-rose); font-size: 0.7em;"></i></h3>
                                <div class="te-section-header-line"></div>
                            </div>
                            <p class="text-muted mb-0">Manage your profile</p>
                        </a>
                    </div>
                </div>

                <!-- RECENT ORDERS -->
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="mb-0 text-dark" style="font-family: var(--font-heading);">Recent Treasures</h3>
                        <a asp-controller="Profile" asp-action="Orders" class="btn btn-outline-primary btn-sm rounded-pill px-4">View All</a>
                    </div>

                    @if (Model.RecentOrders.Any())
                    {
                        <div class="te-form-card p-0 overflow-hidden">
                            <table class="te-luxury-table w-100 mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Order No.</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th class="text-end pe-4">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in Model.RecentOrders)
                                    {
                                        <tr style="cursor: pointer;" onclick="window.location.href='@Url.Action("OrderDetails", "Profile", new { id = o.Id })'">
                                            <td class="ps-4"><strong>@o.OrderNumber</strong></td>
                                            <td class="text-muted">@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                            <td><span class="te-badge te-badge-@o.Status.Badge()">@o.Status.Friendly()</span></td>
                                            <td class="text-end pe-4"><strong>@Threadelle.Helpers.CurrencyFormatter.Format(o.TotalPrice)</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="te-form-card text-center py-5 d-flex flex-column justify-content-center align-items-center" style="border: 1px dashed rgba(235, 212, 206, 0.6);">
                            <div class="te-empty-icon mb-3" style="width: 60px; height: 60px; border-radius: 50%; background: var(--te-light-blush); color: var(--te-dusty-rose); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                                <i class="fas fa-gem"></i>
                            </div>
                            <h4 style="font-family: var(--font-heading); color: var(--te-text-dark);">Your collection is waiting</h4>
                            <p class="text-muted mb-4" style="max-width: 300px;">You haven't added any ThreadElle pieces to your life yet.</p>
                            <a asp-controller="Collections" asp-action="Index" class="btn btn-primary rounded-pill px-4">Begin Your Journey</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
