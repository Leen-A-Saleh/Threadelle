@model CollectionsViewModel
@{
    ViewData["Title"] = "Collections";
    string SortLabel(string v) => v switch
    {
        "price_asc"  => "Price: Low to High",
        "price_desc" => "Price: High to Low",
        "name"       => "Name (A–Z)",
        "oldest"     => "Oldest First",
        _            => "Newest First"
    };
}

<!-- Page header -->
<section class="te-page-header te-page-header--luxury">
    <img src="~/img/hero-bg.png" alt="The Collection Banner" class="te-page-header__bg" />
    <div class="te-page-header__overlay"></div>
    <div class="container text-center te-page-header__content">
        <span class="section-tag">Handmade Treasures</span>
        <h1 class="section-title">The Collection</h1>
        <p class="mx-auto" style="max-width:520px;">
            Browse every piece in the ThreadElle studio — filter by collection or material to find the one that feels like her.
        </p>
    </div>
</section>

<section class="te-section te-section-light pt-0">
    <div class="container">
        <form method="get" id="filterForm" asp-controller="Collections" asp-action="Index">
            <!-- Hidden page field — pagination links update this via JS -->
            <input type="hidden" name="page" id="pageField" value="1" />

            <!-- Mobile filter toggle -->
            <div class="d-flex d-lg-none align-items-center justify-content-between mb-3 pt-2">
                <span class="te-result-count">@Model.TotalCount piece@(Model.TotalCount == 1 ? "" : "s")</span>
                <button type="button" class="te-filter-toggle-btn" id="mobileFilterToggle"
                        aria-expanded="false" aria-controls="filterSidebar">
                    <i class="fas fa-sliders me-2"></i>Filters
                    @if (Model.HasActiveFilters)
                    {
                        <span class="te-filter-badge ms-1">!</span>
                    }
                </button>
            </div>

            <div class="row g-4 mt-0">

                <!-- ══ PRODUCT GRID (right on desktop) ═════════════════════════════ -->
                <div class="col-lg-9 order-1 order-lg-2">

                    <!-- Desktop result count + view toggle -->
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="te-result-count">@Model.TotalCount piece@(Model.TotalCount == 1 ? "" : "s")</span>
                        <div class="d-flex align-items-center gap-3">
                            @if (Model.HasActiveFilters)
                            {
                                <a asp-controller="Collections" asp-action="Index" class="te-clear-link d-none d-lg-inline-flex">
                                    <i class="fas fa-xmark me-1"></i>Clear all filters
                                </a>
                            }
    
                        </div>
                    </div>

                    @if (Model.Products.Any())
                    {
                        <div class="row g-4" id="productGrid">
                            @foreach (var p in Model.Products)
                            {
                                <div class="te-product-col col-xl-4 col-md-6 te-observe">
                                    <partial name="_ProductCard" model="p" />
                                </div>
                            }
                        </div>

                        @if (Model.TotalPages > 1)
                        {
                            <nav class="mt-5" aria-label="Pagination">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                        <button type="button" class="page-link te-page-btn" data-page="@(Model.Page - 1)">
                                            <i class="fas fa-chevron-left"></i>
                                        </button>
                                    </li>
                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == Model.Page ? "active" : "")">
                                            <button type="button" class="page-link te-page-btn" data-page="@i">@i</button>
                                        </li>
                                    }
                                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                        <button type="button" class="page-link te-page-btn" data-page="@(Model.Page + 1)">
                                            <i class="fas fa-chevron-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                    else
                    {
                        <div class="te-empty-state">
                            <i class="fas fa-magnifying-glass te-empty-icon"></i>
                            <h3>No treasures found</h3>
                            <p>We couldn't find anything matching your search. Try a different collection or clear your filters.</p>
                            <a asp-controller="Collections" asp-action="Index" class="btn btn-primary">View Everything</a>
                        </div>
                    }
                </div>

                <!-- ══ FILTER SIDEBAR (left on desktop) ════════════════════════════ -->
                <aside class="col-lg-3 order-2 order-lg-1" id="filterSidebar">
                    <div class="te-filter-panel" id="filterPanel">

                        <!-- ① Search -->
                        <div class="te-filter-group te-filter-search-group">
                            <div class="te-filter-searchbox">
                                <i class="fas fa-magnifying-glass"></i>
                                <input type="text" name="search" value="@Model.Search"
                                       placeholder="Search treasures…" aria-label="Search products" />
                            </div>
                        </div>

                        <!-- ② Sort -->
                        <div class="te-filter-group">
                            <h6 class="te-filter-heading">Sort By</h6>
                            <div class="te-filter-options">
                                @foreach (var opt in new[] { "newest", "oldest", "price_asc", "price_desc", "name" })
                                {
                                    <label class="te-filter-check">
                                        <input type="radio" name="sort" value="@opt"
                                               @(Model.Sort == opt ? "checked" : "") />
                                        <span class="te-check-box te-radio-box"></span>
                                        <span>@SortLabel(opt)</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- ③ Price Range -->
                        <div class="te-filter-group">
                            <h6 class="te-filter-heading">Price</h6>
                            <div class="te-price-range">
                                <div class="te-price-field">
                                    <span class="te-price-symbol"></span>
                                    <input type="number" name="minPrice" id="minPrice"
                                           class="te-price-input"
                                           placeholder="Min" min="0" step="1"
                                           value="@(Model.MinPrice.HasValue ? ((int)Model.MinPrice.Value).ToString() : "")" />
                                </div>
                                <span class="te-price-sep">–</span>
                                <div class="te-price-field">
                                    <span class="te-price-symbol"></span>
                                    <input type="number" name="maxPrice" id="maxPrice"
                                           class="te-price-input"
                                           placeholder="Max" min="0" step="1"
                                           value="@(Model.MaxPrice.HasValue ? ((int)Model.MaxPrice.Value).ToString() : "")" />
                                </div>
                            </div>
                        </div>

                        <!-- ④ Category -->
                        <div class="te-filter-group">
                            <h6 class="te-filter-heading">Collection</h6>
                            <div class="te-filter-options">
                                @foreach (var c in Model.Categories)
                                {
                                    <label class="te-filter-check">
                                        <input type="checkbox" name="categoryIds" value="@c.Id"
                                               @(Model.CategoryIds.Contains(c.Id) ? "checked" : "") />
                                        <span class="te-check-box"></span>
                                        <span>@c.Name</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- ⑤ Material -->
                        <div class="te-filter-group mb-0">
                            <h6 class="te-filter-heading">Material</h6>
                            <div class="te-filter-options">
                                @foreach (var m in Model.Materials)
                                {
                                    <label class="te-filter-check">
                                        <input type="checkbox" name="materialIds" value="@m.Id"
                                               @(Model.MaterialIds.Contains(m.Id) ? "checked" : "") />
                                        <span class="te-check-box"></span>
                                        <span>@m.Name</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="te-filter-actions">
                            <button type="submit" class="btn te-filter-apply-btn w-100">
                                <i class="fas fa-sliders me-2"></i>Apply Filters
                            </button>
                            @if (Model.HasActiveFilters)
                            {
                                <a asp-controller="Collections" asp-action="Index"
                                   class="btn btn-link w-100 mt-1 te-clear-link">
                                    <i class="fas fa-xmark me-1"></i>Clear all
                                </a>
                            }
                        </div>

                    </div><!-- /te-filter-panel -->
                </aside>

            </div><!-- /row -->
        </form>
    </div>
</section>

@section Scripts {
    <script>
        // Pagination: update hidden page field and submit the filter form
        document.querySelectorAll('.te-page-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (this.closest('.page-item').classList.contains('disabled')) return;
                document.getElementById('pageField').value = this.dataset.page;
                document.getElementById('filterForm').submit();
            });
        });

        // Mobile: toggle filter sidebar
        var mobileToggle = document.getElementById('mobileFilterToggle');
        var filterPanel  = document.getElementById('filterPanel');
        if (mobileToggle && filterPanel) {
            mobileToggle.addEventListener('click', function () {
                var expanded = this.getAttribute('aria-expanded') === 'true';
                this.setAttribute('aria-expanded', !expanded);
                filterPanel.classList.toggle('te-filter-panel--open', !expanded);
            });
        }

        // Auto-submit on sort radio change
        document.querySelectorAll('input[name="sort"]').forEach(function (r) {
            r.addEventListener('change', function () {
                document.getElementById('pageField').value = '1';
                document.getElementById('filterForm').submit();
            });
        });

        // ── Quantity selectors on product cards ──────────────────────
        document.querySelectorAll('.te-card__qty').forEach(function (qtyGroup) {
            var input = qtyGroup.querySelector('.te-card__qty-input');
            var dec   = qtyGroup.querySelector('.te-card__qty-dec');
            var inc   = qtyGroup.querySelector('.te-card__qty-inc');
            if (!input || !dec || !inc) return;

            dec.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var v = parseInt(input.value) || 1;
                if (v > 1) input.value = v - 1;
            });
            inc.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var v = parseInt(input.value) || 1;
                if (v < 99) input.value = v + 1;
            });
        });

        // ── Wire up Add To Cart for new card class ──────────────────
        document.querySelectorAll('.te-card__cart-btn').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var productId = this.dataset.productId;
                var card = this.closest('.te-card');
                var qtyInput = card ? card.querySelector('.te-card__qty-input') : null;
                var qty = qtyInput ? parseInt(qtyInput.value) || 1 : 1;
                if (typeof window.teAddToCart === 'function') {
                    window.teAddToCart(productId, null, qty, this);
                }
            });
        });
    </script>
}

