@{
    ViewData["Title"] = "Our Story";
}

<!-- INTRO HERO -->
<section class="te-cta-section d-flex align-items-center justify-content-center" style="background-image: linear-gradient(rgba(0,0,0,.45), rgba(0,0,0,.60)), url('/img/hero-bg.png'); background-attachment: fixed; background-size: cover; background-position: center; min-height: 80vh; padding: 7rem 0;">
    <div class="container text-center" style="position:relative;z-index:1;">
        <div class="te-observe te-visible">
            <span class="section-tag animate-fade-up" style="color: #EBD4CE; text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.85rem; margin-bottom: 1rem;">given from the heart</span>
            <h1 class="animate-fade-up delay-1" style="color:#fff;font-family: 'Playfair Display', serif; font-size:clamp(3rem,6vw,5.5rem); font-style: italic; margin-bottom:.5rem;">
                Our Story
            </h1>
            <p class="animate-fade-up delay-2" style="color:rgba(255,249,247,.9);max-width:650px;margin:1rem auto 0;font-size:1.15rem; line-height: 1.8;">
                ThreadElle is a small handmade studio with a big belief: that the most meaningful gifts
                aren't bought in a hurry — they're created, slowly and lovingly, for someone who matters.
            </p>
        </div>
    </div>
</section>

<!-- LEEN'S JOURNEY -->
<section class="te-section te-section-beige">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5 te-observe">
                <div style="border-radius:var(--r-lg);overflow:hidden;box-shadow:0 24px 60px var(--te-shadow-strong);">
                    <img src="~/img/about-leen.svg" alt="Leen, founder of ThreadElle" style="width:100%;display:block;" />
                </div>
            </div>
            <div class="col-lg-7 te-observe" style="transition-delay:.15s">
                <span class="section-tag">The Hands Behind It</span>
                <h2 class="section-title mb-3">Hello, I'm Leen</h2>
                <p style="color:var(--te-text-secondary);line-height:1.95;margin-bottom:1.25rem;">
                    ThreadElle started the way most loved things do — quietly. A single ball of yarn, a hook,
                    and long evenings teaching my hands to make something out of nothing. What began as a way
                    to calm my mind became a way to say <em>“I made this, for you.”</em>
                </p>
                <p style="color:var(--te-text-secondary);line-height:1.95;margin-bottom:1.25rem;">
                    Friends began asking for pieces. Then their friends. Every order carried a story — a birthday,
                    a new baby, a “just because,” a goodbye. I realised I wasn't really selling crochet and beads.
                    I was helping people hold a feeling in their hands.
                </p>
                <p style="color:var(--te-text-secondary);line-height:1.95;margin-bottom:0;">
                    Today, every ThreadElle piece is still made by me, by hand, one at a time. No factories.
                    No shortcuts. Just patience, colour, and a lot of love stitched into every row.
                </p>
            </div>
        </div>
    </div>
</section>


<!-- THE PROCESS -->
<section class="te-section te-section-beige">
    <div class="container">
        <div class="text-center mb-5 te-observe">
            <span class="section-tag">How a ThreadElle Piece Comes to Life</span>
            <h2 class="section-title">From a Feeling to a Finished Treasure</h2>
        </div>
        <div class="te-journey-container">
            @{
                var steps = new[]
                {
                    ("01", "Dream", "Tell me about her, the moment, the colours you imagine — or pick a piece that already speaks to you.", "fa-cloud"),
                    ("02", "Design", "I gather yarns, beads, and threads by hand, matching every tone to the feeling you want to give.", "fa-pen-nib"),
                    ("03", "Handcrafted", "Stitch by stitch, knot by knot. This is the part that can't be rushed — and that's the whole point.", "fa-hands-holding"),
                    ("04", "Finished Treasure", "Each piece is finished, gift-wrapped, and sent off to begin its story in someone's hands.", "fa-gem")
                };
            }
            @for (int i = 0; i < steps.Length; i++)
            {
                var step = steps[i];
                var delay = (i + 1);
                var sideClass = (i % 2 == 0) ? "te-journey-left" : "te-journey-right";
                <div class="te-journey-item @sideClass te-observe delay-@delay">
                    <div class="te-journey-icon">
                        <i class="fas @step.Item4"></i>
                    </div>
                    <div class="te-journey-card">
                        <span class="te-journey-num">@step.Item1</span>
                        <h4 class="te-journey-title">@step.Item2</h4>
                        <p class="te-journey-text">@step.Item3</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- CTA -->
<section class="te-cta-section">
    <div class="container text-center" style="position:relative;z-index:1;">
        <div class="te-observe">
            <h2 style="color:#fff;font-family:var(--font-script);font-size:clamp(2.3rem,5vw,3.6rem);margin-bottom:.5rem;">Let's make something she'll keep forever</h2>
            <p style="color:rgba(255,249,247,.82);max-width:460px;margin:1rem auto 2.5rem;">
                Browse the collection, or tell me about the gift you're dreaming of.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Collections" asp-action="Index" class="btn-cta-solid"><i class="fas fa-bag-shopping"></i> Explore Collections</a>
                <a asp-controller="CustomOrder" asp-action="Create" class="btn-cta"><i class="fas fa-palette"></i> Start a Custom Order</a>
            </div>
        </div>
    </div>
</section>
