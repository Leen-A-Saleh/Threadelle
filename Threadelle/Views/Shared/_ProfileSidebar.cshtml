@{
    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();
    string Active(params string[] names) => names.Contains(action) ? "is-active" : "";
}
<div class="te-profile-sidebar">
    <div class="te-profile-head">
        @if (!string.IsNullOrEmpty(User.ProfileImage()))
        {
            <img src="@User.ProfileImage()" class="te-profile-avatar" alt="" />
        }
        else
        {
            <span class="te-profile-avatar te-account-avatar-initial">@User.FirstName().Substring(0,1).ToUpper()</span>
        }
        <div class="te-profile-greeting">
            <small>Welcome back</small>
            <strong>@User.DisplayName()</strong>
        </div>
    </div>
    <nav class="te-profile-nav">
        <a asp-controller="Profile" asp-action="Index" class="@Active("index")"><i class="fas fa-gauge"></i> Dashboard</a>
        <a asp-controller="Profile" asp-action="Orders" class="@Active("orders","orderdetails")"><i class="fas fa-box"></i> My Orders</a>
        <a asp-controller="Profile" asp-action="CustomOrders" class="@Active("customorders")"><i class="fas fa-palette"></i> Custom Requests</a>
        <a asp-controller="Profile" asp-action="Testimonials" class="@Active("testimonials")"><i class="fas fa-comment-dots"></i> My Testimonials</a>
        <a asp-controller="Profile" asp-action="Notifications" class="@Active("notifications")"><i class="fas fa-bell"></i> Notifications</a>
        <a asp-controller="Profile" asp-action="Edit" class="@Active("edit")"><i class="fas fa-pen"></i> Edit Profile</a>
    </nav>
</div>
