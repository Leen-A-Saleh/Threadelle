@model List<Threadelle.ViewModels.ProductCardViewModel>
@{
    ViewData["Title"] = "My Wishlist";
}

<section class="te-page-header">
    <div class="container text-center">
        <span class="section-tag">Saved with Love</span>
        <h1 class="section-title">My Wishlist</h1>
        <p style="color:var(--te-text-secondary);">The pieces that caught your heart.</p>
    </div>
</section>

<section class="te-section te-section-light pt-0">
    <div class="container">
        @if (Model.Count == 0)
        {
            <div class="te-empty-state">
                <i class="far fa-heart te-empty-icon"></i>
                <h3>Your wishlist is empty</h3>
                <p>Tap the heart on any piece you love and it'll be saved here for later.</p>
                <a asp-controller="Collections" asp-action="Index" class="btn btn-primary">Explore Products</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var p in Model)
                {
                    <div class="col-lg-3 col-md-6 te-observe">
                        <partial name="_ProductCard" model="p" />
                    </div>
                }
            </div>
        }
    </div>
</section>
