@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="te-auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div style="background:#fff;border-radius:var(--r-lg);box-shadow:0 20px 60px var(--te-shadow-strong);overflow:hidden;">
                    <div style="background:linear-gradient(135deg,var(--te-soft-beige),var(--te-light-blush));padding:2.5rem 2.5rem 2rem;text-align:center;">
                        <span style="font-family:var(--font-script);font-size:2.5rem;color:var(--te-deep-rose);display:block;">ThreadElle</span>
                        <span style="font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--te-gold);">Handmade for Her</span>
                    </div>
                    <div style="padding:2.5rem;">
                        <h2 style="font-family:var(--font-heading);color:var(--te-deep-rose);font-size:1.5rem;margin-bottom:.25rem;">Forgot your password?</h2>
                        <p style="color:var(--te-text-muted);font-size:.875rem;margin-bottom:2rem;">Enter your email and we'll send you a reset link.</p>
                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
                            <div class="form-floating mb-4">
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                <label asp-for="Input.Email">Email address</label>
                                <span asp-validation-for="Input.Email" class="text-danger d-block mt-1"></span>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 btn-lg">
                                <i class="fas fa-paper-plane me-2"></i>Send Reset Link
                            </button>
                        </form>
                        <p class="text-center mt-3 mb-0" style="font-size:.875rem;color:var(--te-text-secondary);">
                            <a asp-page="./Login" style="color:var(--te-rose-mauve);">Back to Sign In</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
