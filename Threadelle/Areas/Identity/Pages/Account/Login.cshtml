@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var returnUrl = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.ReturnUrl ?? "/"))';
        if (typeof window.teOpenAuthModal === 'function') {
            window.teOpenAuthModal('login', returnUrl === '%2F' ? '/' : returnUrl);
        }
    });
</script>
}
