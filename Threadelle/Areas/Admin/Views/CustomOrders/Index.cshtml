@model List<Threadelle.Models.CustomOrder>
@using Threadelle.Helpers
@{
    ViewData["Title"] = "Custom Orders";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string[] statuses = ViewBag.Statuses;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="mb-0" style="color:var(--te-text-muted);font-size:.875rem;">@ViewBag.Total custom orders total</p>
</div>

<form method="get" class="te-admin-card mb-4">
    <div class="te-admin-card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="te-admin-label">Search</label>
                <input type="text" name="search" value="@ViewBag.Search" class="te-admin-ctrl" placeholder="Order # or customer name...">
            </div>
            <div class="col-md-4">
                <label class="te-admin-label">Status</label>
                <select name="status" class="te-admin-ctrl">
                    <option value="">All Statuses</option>
                    @foreach (var s in statuses)
                    {
                        if (ViewBag.StatusFilter == s)
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="te-admin-btn te-admin-btn-primary w-100">
                    <i class="fas fa-search"></i> Filter
                </button>
            </div>
        </div>
    </div>
</form>

<div class="te-admin-card">
    <div class="te-admin-card-body p-0">
        <div class="table-responsive">
            <table class="table te-admin-table mb-0">
                <thead>
                    <tr>
                        <th>Request</th>
                        <th>Customer</th>
                        <th>Category</th>
                        <th>Budget</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var co in Model)
                    {
                        <tr data-row>
                            <td>
                                <div class="te-row-title">@(co.Title ?? co.CustomOrderNumber)</div>
                                <div class="te-row-sub">@co.CustomOrderNumber</div>
                            </td>
                            <td>@(co.User?.FullName ?? "Unknown")</td>
                            <td>@(co.Category?.Name ?? "—")</td>
                            <td>@(co.Budget.HasValue ? $"{co.Budget:0.00} JOD" : "—")</td>
                            <td>
                                @{
                                    var sc = co.Status switch {
                                        Threadelle.Models.CustomOrderStatus.Pending => "pending",
                                        Threadelle.Models.CustomOrderStatus.UnderReview => "inprogress",
                                        Threadelle.Models.CustomOrderStatus.Accepted => "confirmed",
                                        Threadelle.Models.CustomOrderStatus.Rejected => "cancelled",
                                        Threadelle.Models.CustomOrderStatus.InProduction => "inprogress",
                                        Threadelle.Models.CustomOrderStatus.Delivered => "delivered",
                                        _ => "pending"
                                    };
                                }
                                <span class="te-badge te-badge-@sc">@co.Status</span>
                            </td>
                            <td class="te-row-sub">@co.CreatedAt.ToString("MMM d, yyyy")</td>
                            <td class="text-end" data-row>
                                <span class="te-act">
                                    <a asp-area="Admin" asp-controller="CustomOrders" asp-action="Details" asp-route-id="@co.Id"
                                       class="te-act-btn" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <button type="button" class="te-act-btn is-danger te-delete-btn"
                                            data-url="@Url.Action("Delete", "CustomOrders", new { area = "Admin", id = co.Id })"
                                            data-name="@(co.Title ?? co.CustomOrderNumber)" title="Move to Recycle Bin">
                                        <i class="fas fa-trash-can"></i>
                                    </button>
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="te-admin-empty">
                                    <i class="fas fa-palette"></i>
                                    <span>No custom orders found.</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="te-admin-card-body border-top d-flex justify-content-center gap-2">
            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-area="Admin" asp-controller="CustomOrders" asp-action="Index"
                   asp-route-page="@i" asp-route-status="@ViewBag.StatusFilter"
                   class="te-admin-btn te-admin-btn-sm @(i == currentPage ? "te-admin-btn-primary" : "te-admin-btn-outline")">@i</a>
            }
        </div>
    }
</div>
