@model Threadelle.ViewModels.Admin.CouponUpsertViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Coupon" : "Edit Coupon";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to List
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <form asp-action="Upsert" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Code" class="form-label">Coupon Code <span class="text-danger">*</span></label>
                    <input asp-for="Code" class="form-control" style="text-transform:uppercase" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DiscountType" class="form-label">Discount Type <span class="text-danger">*</span></label>
                    <select asp-for="DiscountType" class="form-control" asp-items="Html.GetEnumSelectList<Threadelle.Models.DiscountType>()"></select>
                    <span asp-validation-for="DiscountType" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DiscountValue" class="form-label">Discount Value <span class="text-danger">*</span></label>
                    <input asp-for="DiscountValue" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="DiscountValue" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <input asp-for="EndDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="UsageLimit" class="form-label">Global Usage Limit (Blank for unlimited)</label>
                    <input asp-for="UsageLimit" type="number" class="form-control" />
                    <span asp-validation-for="UsageLimit" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="UsageLimitPerUser" class="form-label">Usage Limit Per User</label>
                    <input asp-for="UsageLimitPerUser" type="number" class="form-control" />
                    <span asp-validation-for="UsageLimitPerUser" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MinOrderAmount" class="form-label">Minimum Order Amount</label>
                    <input asp-for="MinOrderAmount" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="MinOrderAmount" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MaxDiscountAmount" class="form-label">Maximum Discount Amount</label>
                    <input asp-for="MaxDiscountAmount" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="MaxDiscountAmount" class="text-danger"></span>
                </div>
            </div>

            <hr />
            <h5 class="mb-3">Application Scope</h5>

            <div class="mb-3">
                <label asp-for="ApplicationType" class="form-label">Apply To <span class="text-danger">*</span></label>
                <select asp-for="ApplicationType" class="form-control" id="applicationTypeSelect" asp-items="Html.GetEnumSelectList<Threadelle.Models.CouponApplicationType>()"></select>
                <span asp-validation-for="ApplicationType" class="text-danger"></span>
            </div>

            <div id="specificProductsDiv" class="mb-3" style="display:none;">
                <label class="form-label">Select Products</label>
                <select asp-for="SelectedProductIds" class="form-control select2" asp-items="ViewBag.Products" multiple="multiple" style="width: 100%;"></select>
            </div>

            <div id="specificCategoriesDiv" class="mb-3" style="display:none;">
                <label class="form-label">Select Categories</label>
                <select asp-for="SelectedCategoryIds" class="form-control select2" asp-items="ViewBag.Categories" multiple="multiple" style="width: 100%;"></select>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsAutomaticPromotion" class="form-check-input" />
                <label asp-for="IsAutomaticPromotion" class="form-check-label">Automatic Promotion (Applies discount to storefront without a code)</label>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>$(document).ready(function() {
            $('.select2').select2({
                placeholder: "Select options",
                allowClear: true
            });

            function toggleApplicationScope() {
                var type = $('#applicationTypeSelect').val();
                $('#specificProductsDiv').hide();
                $('#specificCategoriesDiv').hide();

                if (type == '1') { // SpecificProducts
                    $('#specificProductsDiv').show();
                } else if (type == '2') { // SpecificCategories
                    $('#specificCategoriesDiv').show();
                }
            }

            $('#applicationTypeSelect').change(toggleApplicationScope);
            toggleApplicationScope();
        });
    </script>
}
